# Copy to `.env` on the EC2 host (next to docker-compose.yml). NEVER commit .env.

# Free DuckDNS domain pointing at this instance's public IP, e.g. ewallet-madhav.duckdns.org
DOMAIN=your-subdomain.duckdns.org

# Container image built + pushed by the deploy workflow (lowercase owner).
APP_IMAGE=ghcr.io/madhavchhabra/e-wallet-backend:latest

# MySQL root password (also used by the app).
DB_PASSWORD=change-me-strong-password

# JWT secrets — must each be at least 32 characters.
JWT_SECRET=change-me-a-very-long-random-jwt-secret-32+chars
REFRESH_SECRET=change-me-a-different-long-random-refresh-secret

# Allowed browser origin(s) for the web demo (comma-separated, no trailing slash).
# e.g. https://madhavchhabra.github.io
CORS_ORIGINS=https://madhavchhabra.github.io

# Razorpay TEST keys (dashboard.razorpay.com -> API Keys / Webhooks)
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google OAuth (Web client id = the serverClientId in the Flutter app)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# Demo convenience: return the password-reset OTP in the API/logs.
EXPOSE_OTP=true
