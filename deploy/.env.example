# Copy to `.env` on the EC2 host (next to docker-compose.yml). NEVER commit .env.

# Free DuckDNS domain pointing at this instance's public IP, e.g. ewallet-madhav.duckdns.org
DOMAIN=your-subdomain.duckdns.org

# Container image built + pushed by the deploy workflow (lowercase owner).
APP_IMAGE=ghcr.io/madhavchhabra/e-wallet-backend:latest

# MySQL root password (also used by the app).
DB_PASSWORD=change-me-strong-password

# JWT secrets — must each be at least 32 characters.
JWT_SECRET=change-me-a-very-long-random-jwt-secret-32+chars
REFRESH_SECRET=change-me-a-different-long-random-refresh-secret

# Allowed browser origin(s) for the web demo (comma-separated, no trailing slash).
# e.g. https://madhavchhabra.github.io
CORS_ORIGINS=https://madhavchhabra.github.io

# Razorpay TEST keys (dashboard.razorpay.com -> API Keys / Webhooks)
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google OAuth. The client id is the *Web application* OAuth client id — this is
# the same value used as `serverClientId` in the Flutter app
# (lib/utils/shared_user.dart). To accept both the Android and Web clients, set a
# comma-separated list of audiences.
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=551536244051-0vfk355lgs5oub30a5b7q4jcregvp394.apps.googleusercontent.com

# File storage for profile / card images.
#   local -> stored on the app-uploads Docker volume (default, works out of the box)
#   s3    -> stored in S3 (durable). Requires:
#            1. an existing S3 bucket (private),
#            2. the EC2 instance role granting s3:PutObject/GetObject on it,
#            3. the instance IMDSv2 hop limit set to 2 (Docker needs the extra hop):
#               aws ec2 modify-instance-metadata-options --instance-id <id> \
#                 --http-put-response-hop-limit 2 --http-tokens required
APP_STORAGE_TYPE=local
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=ap-south-1

# Demo convenience: return the password-reset OTP in the API/logs.
EXPOSE_OTP=true
