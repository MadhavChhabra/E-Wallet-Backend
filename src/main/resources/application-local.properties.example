# Copy this file to application-local.properties and fill in your values.
# application-local.properties is gitignored and loaded automatically in the dev profile.

spring.datasource.url=jdbc:mysql://localhost:3306/ewallet_new
spring.datasource.username=your_mysql_username
spring.datasource.password=your_mysql_password

# Optional: override JWT secrets locally (must be at least 32 characters)
# app.security.jwtSecret=your-local-jwt-secret-at-least-32-characters-long
# app.security.refreshTokenSecret=your-local-refresh-secret-at-least-32-characters-long
